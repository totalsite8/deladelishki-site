---
// Global header: brand link plus primary navigation derived from the
// canonical site tree (src/data/site-tree.js). Only locale-published
// top-level routes are rendered — planned hubs appear automatically as
// their pages are published, and unpublished routes never become dead
// production links. Semantic HTML only: no JS, no Motion.
import siteTree, { homeRoute } from "../../data/site-tree.js";
import { site } from "../../data/site.js";

const { locale } = Astro.props;

const homePath = homeRoute.paths[locale] ?? homeRoute.paths.ru;

const navItems = siteTree
  .filter(
    (node) =>
      node.status !== "utility" &&
      node.localeStatus?.[locale] === "published" &&
      node.paths?.[locale],
  )
  .sort((a, b) => a.order - b.order)
  .map((node) => ({ title: node.title, href: node.paths[locale] }));

const currentPath = Astro.url.pathname;

// Burger menu lists the draft hubs too (they exist locally as noindex
// drafts). Published-only filter above stays untouched for the inline nav.
const menuItems = siteTree
  .filter((node) => node.status !== "utility" && node.paths?.[locale])
  .sort((a, b) => a.order - b.order)
  .map((node) => ({ title: node.title, href: node.paths[locale] }));

const copy = {
  ru: {
    nav: "Основная навигация",
    home: "Dela Delishki — на главную",
    cta: "Обсудить проект",
    menu: "Меню",
    menuOpen: "Открыть меню",
    menuClose: "Закрыть меню",
    menuNav: "Разделы сайта",
  },
  en: {
    nav: "Primary navigation",
    home: "Dela Delishki — home",
    cta: "Discuss a project",
    menu: "Menu",
    menuOpen: "Open menu",
    menuClose: "Close menu",
    menuNav: "Site sections",
  },
}[locale] ?? {
  nav: "Основная навигация",
  home: "Dela Delishki — на главную",
  cta: "Обсудить проект",
  menu: "Меню",
  menuOpen: "Открыть меню",
  menuClose: "Закрыть меню",
  menuNav: "Разделы сайта",
};

// The lead CTA points to the contacts hub (draft page, exists locally).
// The absolute path works from any page.
const ctaHref = `${homePath}kontakty/`;
---

<header class="site-header">
  <div class="site-header__inner">
    <a
      class="site-header__brand"
      href={homePath}
      aria-label={copy.home}
      aria-current={currentPath === homePath ? "page" : undefined}
    >
      {site.name}
    </a>
    {
      navItems.length > 0 && (
        <nav class="site-header__nav" aria-label={copy.nav}>
          <ul class="site-header__list">
            {navItems.map((item) => (
              <li class="site-header__item">
                <a
                  class="site-header__link"
                  href={item.href}
                  aria-current={
                    currentPath === item.href ? "page" : undefined
                  }
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <a class="site-header__cta" href={ctaHref}>{copy.cta}</a>
    <button
      class="site-header__burger"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={copy.menuOpen}
      data-close-label={copy.menuClose}
      data-burger
    >
      <span class="site-header__burger-icon" aria-hidden="true"></span>
      <span class="site-header__burger-text">{copy.menu}</span>
    </button>
  </div>
</header>

<div class="site-menu" id="site-menu" data-menu hidden>
  <nav class="site-menu__nav" aria-label={copy.menuNav}>
    <ul class="site-menu__list">
      {
        menuItems.map((item, index) => (
          <li class="site-menu__item">
            <a
              class="site-menu__link"
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              <span class="site-menu__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="site-menu__cta" href={ctaHref}>{copy.cta}</a>
  </nav>
</div>

<script>
  // Classic burger menu: full-screen overlay, Escape closes, focus returns
  // to the button, body scroll is locked while open. Vanilla enhancement —
  // not a React island; without JS the inline layout still works.
  const burger = document.querySelector("[data-burger]");
  const menu = document.querySelector("[data-menu]");
  if (burger && menu) {
    const openLabel = burger.getAttribute("aria-label") || "Menu";
    const closeLabel = burger.dataset.closeLabel || openLabel;

    function setOpen(open, { refocus = true } = {}) {
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute("aria-label", open ? closeLabel : openLabel);
      menu.hidden = !open;
      document.documentElement.classList.toggle("menu-open", open);
      if (open) {
        menu.querySelector("a")?.focus();
      } else if (refocus) {
        burger.focus();
      }
    }

    burger.addEventListener("click", () => {
      setOpen(burger.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        event.preventDefault();
        setOpen(false);
      }
    });

    menu.addEventListener("click", (event) => {
      if (event.target.closest("a")) setOpen(false, { refocus: false });
    });
  }
</script>

<style>
  /* Sticky with a functional translucent backdrop: readability over the
   * hero field is the only allowed "glass" — not decoration. Kept quiet so
   * the header reads as part of the hero, not a separate strip. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--dd-z-header);
    border-bottom: 1px solid var(--dd-hairline);
    background-color: color-mix(in srgb, var(--dd-color-canvas) 62%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--dd-space-xs) var(--dd-space-md);
    width: 100%;
    padding: var(--dd-space-xs) var(--dd-space-md);
  }

  .site-header__brand {
    display: inline-block;
    padding: var(--dd-space-xs) 0;
    color: var(--dd-color-text);
    font-family: var(--dd-font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--dd-color-action-hover);
  }

  .site-header__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dd-space-xs) var(--dd-space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__link {
    display: inline-block;
    padding: var(--dd-space-xs) var(--dd-space-xs);
    color: var(--dd-color-muted);
    text-decoration: none;
    border-radius: var(--dd-radius-sm);
  }

  .site-header__link:hover {
    color: var(--dd-color-action-hover);
  }

  .site-header__link[aria-current="page"] {
    color: var(--dd-color-action);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--dd-node-size-min);
    padding: 0.4em 1.2em;
    border: 1px solid var(--dd-color-action);
    border-radius: var(--dd-radius-full);
    background-color: var(--dd-color-action);
    color: var(--dd-color-canvas);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      background-color var(--dd-duration-fast) var(--dd-ease-out),
      border-color var(--dd-duration-fast) var(--dd-ease-out);
  }

  .site-header__cta:hover {
    border-color: var(--dd-color-action-hover);
    background-color: var(--dd-color-action-hover);
    color: var(--dd-color-canvas);
  }

  .site-header__burger {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: var(--dd-node-size-min);
    padding: 0.4em 1em;
    border: 1px solid var(--dd-color-border);
    border-radius: var(--dd-radius-full);
    background: none;
    color: var(--dd-color-text);
    font-weight: 700;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      border-color var(--dd-duration-fast) var(--dd-ease-out),
      color var(--dd-duration-fast) var(--dd-ease-out);
  }

  .site-header__burger:hover {
    border-color: var(--dd-color-action);
    color: var(--dd-color-action-hover);
  }

  .site-header__burger-icon {
    position: relative;
    width: 1.1em;
    height: 2px;
    background-color: currentColor;
  }

  .site-header__burger-icon::before,
  .site-header__burger-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transition: transform var(--dd-duration-fast) var(--dd-ease-out);
  }

  .site-header__burger-icon::before {
    transform: translateY(-5px);
  }

  .site-header__burger-icon::after {
    transform: translateY(5px);
  }

  .site-header__burger[aria-expanded="true"] .site-header__burger-icon {
    background-color: transparent;
  }

  .site-header__burger[aria-expanded="true"] .site-header__burger-icon::before {
    transform: rotate(45deg);
  }

  .site-header__burger[aria-expanded="true"] .site-header__burger-icon::after {
    transform: rotate(-45deg);
  }
</style>

<style>
  /* Overlay is global (fixed positioning outside the header flow). */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: var(--dd-z-overlay);
    padding: calc(var(--dd-space-2xl) + 2rem) var(--dd-container-gutter)
      var(--dd-space-xl);
    background-color: color-mix(in srgb, var(--dd-color-canvas) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow-y: auto;
  }

  .site-menu__nav {
    width: 100%;
    max-width: var(--dd-container-max);
    margin: 0 auto;
  }

  .site-menu__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--dd-hairline);
  }

  .site-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--dd-space-md);
    min-height: var(--dd-node-size-min);
    padding: var(--dd-space-sm) 0;
    border-top: 1px solid var(--dd-hairline);
    color: var(--dd-color-text);
    font-family: var(--dd-font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    font-weight: 700;
    text-decoration: none;
    transition: color var(--dd-duration-fast) var(--dd-ease-out);
  }

  .site-menu__link:hover {
    color: var(--dd-color-action-hover);
  }

  .site-menu__link[aria-current="page"] {
    color: var(--dd-color-action);
  }

  .site-menu__number {
    color: var(--dd-color-muted);
    font-family: var(--dd-font-mono);
    font-size: 0.8125rem;
    letter-spacing: var(--dd-eyebrow-tracking);
  }

  .site-menu__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--dd-node-size-min);
    margin-top: var(--dd-space-lg);
    padding: 0.6em 1.4em;
    border: 1px solid var(--dd-color-action);
    border-radius: var(--dd-radius-full);
    background-color: var(--dd-color-action);
    color: var(--dd-color-canvas);
    font-weight: 700;
    text-decoration: none;
  }

  .site-menu__cta:hover {
    border-color: var(--dd-color-action-hover);
    background-color: var(--dd-color-action-hover);
    color: var(--dd-color-canvas);
  }
</style>

<style is:global>
  /* body scroll lock while the menu is open; header stays above the
     overlay so the burger can close it */
  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }

  html.menu-open .site-header {
    z-index: var(--dd-z-toast);
  }
</style>
