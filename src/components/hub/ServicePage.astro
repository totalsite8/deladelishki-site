---
// Direction page (услуги/<направление>): lusion-style interactive hero
// (cursor-reactive canvas field) + kdm-style direct tone. Spotlight cards,
// scroll-charged process line, magnetic CTA. Content: src/data/services.js.
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBadge from "../home/StatusBadge.astro";
import { servicePages } from "../../data/services.js";
import { detailsForParent } from "../../data/service-details/index.js";
import { site } from "../../data/site.js";
import "./biz.css";

const { service } = Astro.props;
const related = servicePages.filter((item) => item.slug !== service.slug);
const detailByTitle = new Map(
  detailsForParent(service.slug).map((item) => [item.title, item.slug]),
);

const principles = [
  "Без лишних формальностей и брифов на 40 страниц",
  "Не предлагаю лишнего: если задача решается проще — скажу прямо",
  "Цифры показываю как есть, без приукрашивания",
  "Один человек отвечает за результат, а не команда аккаунтов",
];
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  locale="ru"
  routeId={service.routeId}
  noindex
  theme="portal"
>
  <main>
    <section class="biz-hero">
      <canvas class="biz-hero__field" data-biz-field aria-hidden="true"></canvas>
      <div class="biz-hero__inner">
        <nav class="biz-hero__crumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a>
          <span aria-hidden="true"> / </span>
          <a href="/uslugi/">Услуги</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{service.navTitle}</span>
        </nav>
        <p
          class="biz-hero__eyebrow"
          style={`color: var(--dd-domain-${service.domain})`}
        >
          Направление / {service.navTitle}
        </p>
        <h1 class="biz-hero__title">{service.h1}</h1>
        <p class="biz-hero__offer">{service.offer}</p>
        <div class="biz-hero__actions">
          <a class="biz-cta" href="/kontakty/" data-magnetic>Обсудить проект</a>
          <a class="biz-cta biz-cta--ghost" href="#svc-includes">Что входит ↓</a>
          <StatusBadge status={service.status} />
        </div>
        <ul class="biz-principles">
          {principles.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <div class="biz">
      <section class="biz-section" aria-labelledby="svc-situations">
        <h2 class="biz-section__h2" id="svc-situations">
          <span>01</span>Когда это нужно
        </h2>
        <ul class="biz-cards">
          {
            service.situations.map((item) => (
              <li class="biz-card" data-spot>{item}</li>
            ))
          }
        </ul>
      </section>

      <section class="biz-section" aria-labelledby="svc-includes">
        <h2 class="biz-section__h2" id="svc-includes">
          <span>02</span>Что входит
        </h2>
        <ul class="biz-cards biz-cards--three">
          {
            service.includes.map((item) => {
              const detailSlug = detailByTitle.get(item.label);
              return (
                <li class="biz-card" data-spot>
                  <h3 class="biz-card__title">
                    {detailSlug ? (
                      <a href={`/uslugi/${service.slug}/${detailSlug}/`}>
                        {item.label}
                      </a>
                    ) : (
                      item.label
                    )}
                  </h3>
                  <p class="biz-card__text">{item.text}</p>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="biz-section" aria-labelledby="svc-process">
        <h2 class="biz-section__h2" id="svc-process">
          <span>03</span>Как я работаю
        </h2>
        <ol class="biz-steps">
          {
            service.process.map((step, index) => (
              <li class="biz-step" data-step>
                <span class="biz-step__num">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="biz-step__title">{step.title}</h3>
                <p class="biz-step__text">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="biz-section" aria-labelledby="svc-boundaries">
        <h2 class="biz-section__h2" id="svc-boundaries">
          <span>04</span>Чего я не обещаю
        </h2>
        <ul class="biz-boundaries">
          {service.boundaries.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="biz-section" aria-labelledby="svc-faq">
        <h2 class="biz-section__h2" id="svc-faq">
          <span>05</span>Частые вопросы
        </h2>
        <div class="biz-faq">
          {
            service.faq.map((item) => (
              <details class="biz-faq__item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <nav class="biz-related" aria-label="Другие направления">
        <p class="biz-related__label">Другие направления услуг</p>
        <ul>
          {
            related.map((item) => (
              <li>
                <a href={`/uslugi/${item.slug}/`}>{item.navTitle}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <section class="biz-final" aria-labelledby="svc-cta">
      <h2 class="biz-final__title" id="svc-cta">{service.cta}</h2>
      <ul class="biz-final__contacts">
        <li>
          <a href={site.emailHref} data-magnetic>{site.email}</a>
        </li>
        <li>
          <a href={site.phoneHref} data-magnetic>{site.phoneDisplay}</a>
        </li>
        <li>
          <a href={site.vk} target="_blank" rel="noopener noreferrer" data-magnetic>
            VK
          </a>
        </li>
      </ul>
    </section>
  </main>

  <script>
    import { initBiz } from "./biz-interactions.js";
    initBiz();
  </script>
</BaseLayout>
