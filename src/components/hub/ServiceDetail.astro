---
// Second-level service page (/uslugi/<direction>/<slug>/): same interactive
// language as direction pages — canvas hero field, spotlight cards,
// scroll-charged process, magnetic CTA. Content: src/data/service-details/*.
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBadge from "../home/StatusBadge.astro";
import { servicePages } from "../../data/services.js";
import { detailsForParent } from "../../data/service-details/index.js";
import { site } from "../../data/site.js";
import "./biz.css";

const { detail } = Astro.props;
const parent = servicePages.find((item) => item.slug === detail.parent);
const siblings = detailsForParent(detail.parent).filter(
  (item) => item.slug !== detail.slug,
);
---

<BaseLayout
  title={detail.seo.title}
  description={detail.seo.description}
  locale="ru"
  routeId={detail.routeId}
  noindex
  theme="portal"
>
  <main>
    <section class="biz-hero">
      <canvas class="biz-hero__field" data-biz-field aria-hidden="true"></canvas>
      <div class="biz-hero__inner">
        <nav class="biz-hero__crumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a>
          <span aria-hidden="true"> / </span>
          <a href="/uslugi/">Услуги</a>
          <span aria-hidden="true"> / </span>
          <a href={`/uslugi/${detail.parent}/`}>{parent?.navTitle}</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{detail.title}</span>
        </nav>
        <p
          class="biz-hero__eyebrow"
          style={parent ? `color: var(--dd-domain-${parent.domain})` : undefined}
        >
          {parent?.navTitle} / {detail.title}
        </p>
        <h1 class="biz-hero__title">{detail.h1}</h1>
        <p class="biz-hero__offer">{detail.offer}</p>
        <div class="biz-hero__actions">
          <a class="biz-cta" href="/kontakty/" data-magnetic>Обсудить проект</a>
          <StatusBadge status={detail.status} />
        </div>
      </div>
    </section>

    <div class="biz">
      <section class="biz-section" aria-labelledby="svc-situations">
        <h2 class="biz-section__h2" id="svc-situations">
          <span>01</span>Когда это нужно
        </h2>
        <ul class="biz-cards">
          {
            detail.situations.map((item) => (
              <li class="biz-card" data-spot>{item}</li>
            ))
          }
        </ul>
      </section>

      <section class="biz-section" aria-labelledby="svc-deliverables">
        <h2 class="biz-section__h2" id="svc-deliverables">
          <span>02</span>Что вы получаете
        </h2>
        <ul class="biz-cards biz-cards--three">
          {
            detail.deliverables.map((item) => (
              <li class="biz-card" data-spot>
                <h3 class="biz-card__title">{item.label}</h3>
                <p class="biz-card__text">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="biz-section" aria-labelledby="svc-process">
        <h2 class="biz-section__h2" id="svc-process">
          <span>03</span>Как я работаю
        </h2>
        <ol class="biz-steps">
          {
            detail.process.map((step, index) => (
              <li class="biz-step" data-step>
                <span class="biz-step__num">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="biz-step__title">{step.title}</h3>
                <p class="biz-step__text">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="biz-section" aria-labelledby="svc-boundaries">
        <h2 class="biz-section__h2" id="svc-boundaries">
          <span>04</span>Чего я не обещаю
        </h2>
        <ul class="biz-boundaries">
          {detail.boundaries.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="biz-section" aria-labelledby="svc-faq">
        <h2 class="biz-section__h2" id="svc-faq">
          <span>05</span>Частые вопросы
        </h2>
        <div class="biz-faq">
          {
            detail.faq.map((item) => (
              <details class="biz-faq__item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <nav class="biz-related" aria-label="Другие услуги направления">
        <p class="biz-related__label">
          Ещё в направлении «{parent?.navTitle}»
        </p>
        <ul>
          {
            siblings.map((item) => (
              <li>
                <a href={`/uslugi/${detail.parent}/${item.slug}/`}>{item.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <section class="biz-final" aria-labelledby="svc-cta">
      <h2 class="biz-final__title" id="svc-cta">{detail.cta}</h2>
      <ul class="biz-final__contacts">
        <li>
          <a href={site.emailHref} data-magnetic>{site.email}</a>
        </li>
        <li>
          <a href={site.phoneHref} data-magnetic>{site.phoneDisplay}</a>
        </li>
        <li>
          <a href={site.vk} target="_blank" rel="noopener noreferrer" data-magnetic>
            VK
          </a>
        </li>
      </ul>
    </section>
  </main>

  <script>
    import { initBiz } from "./biz-interactions.js";
    initBiz();
  </script>
</BaseLayout>
